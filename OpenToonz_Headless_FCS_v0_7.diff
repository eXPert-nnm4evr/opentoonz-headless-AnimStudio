+QScriptValue Level::getMeshInfo(int frame) {
+  if (!m_sl || frame < 1) {
+    return context()->throwError("getMeshInfo requires a valid level and frame >= 1");
+  }
+  TFrameId fid(frame);
+  TImageP image = m_sl->getFrame(fid, false);
+  TMeshImage *meshImage = image ? dynamic_cast<TMeshImage *>(image.getPointer()) : nullptr;
+  if (!meshImage) {
+    return context()->throwError("Requested level frame is not a Plastic mesh image");
+  }
+
+  QScriptEngine *engine = context()->engine();
+  QScriptValue result = engine->newObject();
+  const auto &meshes = meshImage->meshes();
+  QScriptValue items = engine->newArray(static_cast<uint>(meshes.size()));
+  for (int i = 0; i < static_cast<int>(meshes.size()); ++i) {
+    QScriptValue item = engine->newObject();
+    item.setProperty("index", i);
+    item.setProperty("vertexCount", meshes[i]->verticesCount());
+    items.setProperty(i, item);
+  }
+  result.setProperty("meshCount", static_cast<int>(meshes.size()));
+  result.setProperty("meshes", items);
+  result.setProperty("coordinateSpace",
+                     engine->toScriptValue(QStringLiteral("centered-stage-y-up")));
+  return result;
+}
+
+QScriptValue Level::getMeshVertices(int meshIndex, int frame) {
+  if (!m_sl || frame < 1) {
+    return context()->throwError("getMeshVertices requires a valid level and frame >= 1");
+  }
+  TImageP image = m_sl->getFrame(TFrameId(frame), false);
+  TMeshImage *meshImage = image ? dynamic_cast<TMeshImage *>(image.getPointer()) : nullptr;
+  if (!meshImage) {
+    return context()->throwError("Requested level frame is not a Plastic mesh image");
+  }
+  const auto &meshes = meshImage->meshes();
+  if (meshIndex < 0 || meshIndex >= static_cast<int>(meshes.size())) {
+    return context()->throwError("Mesh index out of range");
+  }
+
+  const TTextureMesh &mesh = *meshes[meshIndex];
+  QScriptEngine *engine = context()->engine();
+  QScriptValue result = engine->newArray(static_cast<uint>(mesh.verticesCount()));
+  for (int i = 0; i < mesh.verticesCount(); ++i) {
+    const RigidPoint &p = mesh.vertex(i).P();
+    QScriptValue item = engine->newObject();
+    item.setProperty("index", i);
+    item.setProperty("x", p.x);
+    item.setProperty("y", p.y);
+    item.setProperty("rigidity", p.rigidity);
+    result.setProperty(i, item);
+  }
+  return result;
+}
+
+QScriptValue Level::setMeshRigidityAtPoint(int meshIndex, int frame,
+                                           double x, double y, double radius,
+                                           double rigidity) {
+  if (!m_sl || frame < 1) {
+    return context()->throwError("setMeshRigidityAtPoint requires a valid level and frame >= 1");
+  }
+  if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(radius) ||
+      !std::isfinite(rigidity) || radius <= 0.0 || rigidity < 1.0 || rigidity > 10000.0) {
+    return context()->throwError(
+        "Rigidity painting expects finite x/y, radius > 0, and rigidity in [1, 10000]");
+  }
+
+  const TFrameId fid(frame);
+  TImageP image = m_sl->getFrame(fid, false);
+  TMeshImage *meshImage = image ? dynamic_cast<TMeshImage *>(image.getPointer()) : nullptr;
+  if (!meshImage) {
+    return context()->throwError("Requested level frame is not a Plastic mesh image");
+  }
+  auto &meshes = meshImage->meshes();
+  if (meshIndex < 0 || meshIndex >= static_cast<int>(meshes.size())) {
+    return context()->throwError("Mesh index out of range");
+  }
+
+  TTextureMesh &mesh = *meshes[meshIndex];
+  const double radius2 = radius * radius;
+  int changed = 0;
+  for (int i = 0; i < mesh.verticesCount(); ++i) {
+    RigidPoint &p = mesh.vertex(i).P();
+    const double dx = p.x - x;
+    const double dy = p.y - y;
+    if (dx * dx + dy * dy <= radius2) {
+      p.rigidity = rigidity;
+      ++changed;
+    }
+  }
+
+  if (changed > 0) {
+    m_sl->setFrame(fid, image);
+    m_sl->setDirtyFlag(true);
+    PlasticDeformerStorage::instance()->invalidateMeshImage(
+        meshImage, PlasticDeformerStorage::MESH);
+  }
+  return QScriptValue(changed);
+}
