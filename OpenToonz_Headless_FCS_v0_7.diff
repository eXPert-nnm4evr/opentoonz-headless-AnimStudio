+QScriptValue PlasticRig::setVertexAngleLimits(int vertexIdx,
+                                                   double minAngle,
+                                                   double maxAngle) {
+  if (vertexIdx < 0 || vertexIdx >= getVertexCount()) {
+    return context()->throwError(
+        tr("Vertex index %1 out of range").arg(vertexIdx));
+  }
+  if (!std::isfinite(minAngle) || !std::isfinite(maxAngle) ||
+      minAngle >= maxAngle || minAngle < -360.0 || maxAngle > 360.0) {
+    return context()->throwError(
+        tr("Angle limits must be finite, increasing values in [-360, 360]"));
+  }
+
+  PlasticSkeletonVertex &vertex = m_skeleton->vertex(vertexIdx);
+  vertex.m_minAngle = minAngle;
+  vertex.m_maxAngle = maxAngle;
+  // Native Plastic caches the compiled handle data; invalidate it after
+  // changing limits so a later render cannot reuse stale deformation data.
+  PlasticDeformerStorage::instance()->invalidateSkeleton(
+      m_deformation, 0, PlasticDeformerStorage::ALL);
+  return context()->thisObject();
+}
